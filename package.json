{
  "name": "artizen-fyi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cron:prod": "wrangler dev --env cron --port 8788",
    "deploy": "wrangler deploy",
    "build:client": "node scripts/build-client.mjs",
    "prepare:semantic": "node scripts/fetch-semantic-assets.mjs",
    "build:semantic-vectors": "node scripts/build-semantic-vectors.mjs",
    "typecheck": "tsc && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate:matching": "node scripts/evaluate-matching.mjs",
    "evaluate:matching:v2": "node scripts/evaluate-matching-v2.mjs",
    "inspect:matching:v2": "node scripts/inspect-match-v2.mjs",
    "benchmark:matching:v2": "node scripts/benchmark-match-v2.mjs",
    "qa:match": "node scripts/serve-match-qa.mjs",
    "check": "npm run typecheck && npm test && npm run build:client",
    "kv:create": "wrangler kv namespace create CACHE",
    "types": "wrangler types"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
