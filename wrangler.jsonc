{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artizen",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "replace-with-kv-namespace-id"
    }
  ]
}
